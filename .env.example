# Bridgic Agent backend process configuration — copy to `.env` as needed.
# Model providers and model selection are configured in the product UI.

# Safety-classifier timeout in seconds. Default: 90.
# AMPHI_CLASSIFIER_TIMEOUT=90

# Persist service state at a custom path.
# BRIDGIC_AGENT_STATE_DB=/path/to/state.db

# Write each thinking call to <session_root>/.internal/debug/.
# BRIDGIC_AGENT_THINKING_DEBUG=1
