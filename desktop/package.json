{
  "name": "bridgic-agent-desktop",
  "version": "0.1.2",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "description": "Bridgic Agent — Electron GUI client for the Bridgic Agent backend daemon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitsky-tech/bridgic-agent.git"
  },
  "homepage": "https://github.com/bitsky-tech/bridgic-agent",
  "bugs": {
    "url": "https://github.com/bitsky-tech/bridgic-agent/issues"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "electron",
    "esbuild",
    "sharp"
  ],
  "scripts": {
    "dev": "bun run scripts/electron-dev.ts",
    "dev:resources": "bun run scripts/ensure-runtime-resources.ts",
    "build": "bun run scripts/electron-build.ts && bun run licenses",
    "licenses": "bun run scripts/gen-third-party-licenses.ts",
    "build:main": "bun run scripts/electron-build-main.ts",
    "build:preload": "bun run scripts/electron-build-preload.ts",
    "build:renderer": "bun run scripts/electron-build-renderer.ts",
    "build:resources": "bun run scripts/electron-build-resources.ts",
    "clean": "bun run scripts/electron-clean.ts",
    "start": "bun run build && electron apps/electron",
    "prebuild:fetch-amphi": "bun run scripts/prebuild-fetch-amphi.ts",
    "prebuild:fetch-uv": "bun run scripts/prebuild-fetch-uv.ts",
    "prebuild:fetch-python": "bun run scripts/prebuild-fetch-python.ts",
    "prebuild:fetch-node": "bun run scripts/prebuild-fetch-node.ts",
    "release-manifest": "bun run scripts/release-manifest.ts",
    "check:payload-paths": "bun run scripts/check-payload-paths.ts",
    "check:chinese": "bun run scripts/check-chinese.ts",
    "dist:mac": "bun run scripts/prebuild-fetch-amphi.ts arm64 && bun run scripts/prebuild-fetch-uv.ts arm64 && bun run scripts/prebuild-fetch-python.ts arm64 && bun run scripts/prebuild-fetch-node.ts arm64 && bun run check:payload-paths && bash apps/electron/scripts/build-dmg.sh arm64",
    "dist:mac:x64": "bun run scripts/prebuild-fetch-amphi.ts x64 && bun run scripts/prebuild-fetch-uv.ts x64 && bun run scripts/prebuild-fetch-python.ts x64 && bun run scripts/prebuild-fetch-node.ts x64 && bun run check:payload-paths && bash apps/electron/scripts/build-dmg.sh x64",
    "dist:win": "bun run scripts/prebuild-fetch-amphi.ts x64 && bun run scripts/prebuild-fetch-uv.ts x64 && bun run scripts/prebuild-fetch-python.ts x64 && bun run scripts/prebuild-fetch-node.ts x64 && bun run check:payload-paths && powershell -ExecutionPolicy Bypass -File apps/electron/scripts/build-win.ps1",
    "dist:linux": "bun run scripts/prebuild-fetch-amphi.ts x64 && bun run scripts/prebuild-fetch-uv.ts x64 && bun run scripts/prebuild-fetch-python.ts x64 && bun run scripts/prebuild-fetch-node.ts x64 && bun run check:payload-paths && bash apps/electron/scripts/build-linux.sh",
    "typecheck": "bun run typecheck:shared && bun run typecheck:ui && bun run typecheck:electron && bun run typecheck:scripts",
    "typecheck:shared": "cd packages/shared && tsc --noEmit",
    "typecheck:ui": "cd packages/ui && tsc --noEmit",
    "typecheck:electron": "cd apps/electron && tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint apps packages scripts",
    "lint:fix": "eslint apps packages scripts --fix",
    "check:naming": "bash scripts/check-naming.sh",
    "check:doc-links": "bun run scripts/check-doc-links.ts",
    "check:locales": "bun run scripts/sort-locales.ts --check --check-parity",
    "test": "bun test --preload ./test-setup.ts apps packages scripts",
    "sort-locales": "bun run scripts/sort-locales.ts",
    "set-version": "bun run scripts/set-version.ts",
    "icons": "bun run apps/electron/resources/generate-icons.ts",
    "icons:tray": "bun run apps/electron/resources/generate-tray-icons.ts",
    "prepare": "cd .. && husky"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.8",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jotai-babel": "^0.3.0",
    "js-yaml": "^4.1.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.0.0",
    "vite": "^6.2.4"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.0.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jotai": "^2.16.0",
    "jotai-family": "^1.0.2",
    "lucide-react": "^0.561.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.2",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.0.0"
  }
}
