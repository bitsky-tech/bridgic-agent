# Copy this file to .env and fill in values your app needs.
# Variables here are loaded by scripts/electron-dev.ts and scripts/electron-build-main.ts
# and forwarded to the Electron main process via esbuild --define.

# App identity
#
# APP_NAME is deliberately NOT set here. `app.setName()` falls back to
# app-meta.ts's APP_PRODUCT_NAME (index.ts: `process.env.APP_NAME ||
# APP_PRODUCT_NAME`, and an unset build-time var is defined as ''), which is the
# single source of truth the branding contract test pins. Setting it here
# re-opens the exact trap that constant exists to close: `cp .env.example .env`
# is step one of the README, so a literal in this file silently outranks the
# rename for every developer and CI job that followed the instructions — the
# menu bar and notifications would say one name while the window title,
# installer and About dialog say another, and on Windows userData would land in
# a directory the uninstaller does not remove.
#
# If your local .env still carries `APP_NAME=Amphi` from before 2026-08, delete
# that line.
#
# APP_DEEPLINK_SCHEME must equal electron-builder.yml `protocols.schemes`
# (baked into Info.plist / the NSIS registry) AND the backend's
# `_codex_oauth.py :: APP_SCHEME`. A mismatch means setAsDefaultProtocolClient
# registers one scheme while the OS advertises another — the Codex OAuth
# success page's `amphi://oauth/callback` then never reaches the app.
APP_DEEPLINK_SCHEME=amphi

# Auto-update (electron-updater generic provider)
# Point at a static directory that hosts latest.yml / latest-mac.yml / latest-linux.yml
# Example: https://releases.example.com/my-app
APP_UPDATE_URL=

# Debug flag — when "1" or "true", main process logs to console at debug level
APP_DEBUG=

# Optional pseudonymous usage telemetry (PostHog US Cloud project token).
# This is a public, write-only ingestion token; never put a personal or secret
# PostHog API key here. With no token, telemetry is a complete no-op even when
# the local development switch is enabled.
POSTHOG_PROJECT_TOKEN=

# Vite dev-server port. Uncomment if 5173 conflicts with another local Vite
# project (e.g. you run two Electron+Vite repos side by side — the scripts/
# electron-dev.ts `--strictPort` will else kill the other project's Vite).
# Pick any free port; Electron's renderer reads VITE_DEV_SERVER_URL from this.
# APP_VITE_PORT=5174

# Code signing / notarization (macOS, optional — leave blank for unsigned local builds)
# See README.md "macOS code signing & notarization" for the full walkthrough.
#
# APPLE_SIGNING_IDENTITY MUST be quoted: the value contains spaces and parentheses,
# and build-dmg.sh `source`s this file. Unquoted, the shell parses them as syntax,
# the variable silently becomes empty, and the build downgrades to UNSIGNED with no
# error at all. Copy the exact string from `security find-identity -v -p codesigning`.
# Example: APPLE_SIGNING_IDENTITY="Developer ID Application: Jane Doe (AB12CD34EF)"
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_TEAM_ID=
# appleid.apple.com → Sign-In and Security → App-Specific Passwords.
# NOT your Apple ID login password.
APPLE_APP_SPECIFIC_PASSWORD=
