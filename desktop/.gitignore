# dependencies
node_modules

# build output
dist
build
out
release

# bundled sidecar binaries (produced at build/package time)
apps/electron/resources/bin/
apps/electron/resources/uv_runtime/
apps/electron/resources/python_runtime/
apps/electron/resources/node_runtime/
apps/electron/resources/updater_tools/

# Generated by scripts/release-manifest.ts on every build. Deliberately NOT
# committed: it is derived from src/__init__.py + package.json, so a checked-in
# copy could only ever be stale or a merge conflict — and a stale one means the
# packaged GUI demands the wrong backend version.
apps/electron/resources/release-manifest.json

# Generated by scripts/gen-third-party-licenses.ts after every build. ~900 KB of
# license text derived from the actual bundle + the PyInstaller payload, so a
# committed copy would go stale the moment a dependency moves — and a stale one
# is worse than none: it asserts we shipped notices we no longer ship.
# LICENSE / NOTICE here are build-time COPIES of the repo-root originals, staged
# so electron-builder can address the whole compliance set from one directory.
apps/electron/resources/THIRD-PARTY-LICENSES.txt
apps/electron/resources/LICENSE
apps/electron/resources/NOTICE

# Exceptions: electron-builder hook scripts live under apps/electron/build/.
!apps/electron/build/
!apps/electron/build/**
*.tsbuildinfo

# e2e test artifacts
tests/e2e/playwright-report/
tests/e2e/test-results/

# logs
logs
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# environment files
.env
.env.local
.env.*.local

# caches
.cache
.eslintcache
.vite

# IDE
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# OS
.DS_Store
Thumbs.db

# lock files of other package managers (project uses Bun)
pnpm-lock.yaml
package-lock.json
yarn.lock

# misc secrets
*.pem
*.key
sshkey
id_rsa*
id_ed25519*

# tilde escape (Node does not expand ~)
~/
